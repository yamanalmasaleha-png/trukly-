# BiteShark root holding page (`https://biteshark.live`) & canonical `www.biteshark.live` redirect.
#
# Co-tenant safety invariants on 172.233.140.74:
#   - Install at `/etc/nginx/sites-available/biteshark.live` and symlink as
#     `/etc/nginx/sites-enabled/z-biteshark.live` (prefixed `z-` so `/etc/nginx/sites-enabled/lifestyle-api`,
#     which uses `listen 80; server_name _;` without `default_server`, remains the first-loaded default `:80` host).
#   - IPv4 `listen` only (`biteshark.live` publishes `A -> 172.233.140.74` with no `AAAA` record).
#   - Serves ONLY `/srv/biteshark/holding/public/index.html` until production cutover is separately authorized.
#   - HSTS uses `max-age=31536000` WITHOUT `includeSubDomains` or `preload`.

server {
    listen 80;
    server_name biteshark.live;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://biteshark.live$request_uri;
    }
}

server {
    listen 80;
    server_name www.biteshark.live;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://biteshark.live$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name www.biteshark.live;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/biteshark.live/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/biteshark.live/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:BiteSharkTLS:2m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location / {
        return 301 https://biteshark.live$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name biteshark.live;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/biteshark.live/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/biteshark.live/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:BiteSharkTLS:2m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;

    location ~ /\.(?!well-known) {
        return 404;
    }

    root /srv/biteshark/holding/public;
    index index.html;

    location = / {
        try_files /index.html =404;
    }

    location = /index.html {
        try_files /index.html =404;
    }

    location / {
        return 404;
    }
}
