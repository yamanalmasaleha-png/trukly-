# Host-specific Nginx virtual host for Truckly Isolated Staging.
# Never uses `server_name _;` or `default_server` so existing `/etc/nginx/sites-enabled/lifestyle-api`
# default HTTP routing on port 80 remains completely undisturbed.
#
# Activation checklist (ONLY after staging DNS `A`/`AAAA` resolves to VPS):
#   1. Render `__STAGING_FQDN__` -> `/etc/nginx/sites-available/truckly-staging` (HTTP-only block first for webroot ACME,
#      or issue cert via `certbot certonly --webroot -w /var/www/html -d <fqdn>` before enabling the `:443` server block).
#   2. Set `TRUCKLY_PUBLIC_ORIGIN=https://<fqdn>` and `TRUCKLY_TRUST_PROXY=loopback` in `/etc/truckly-staging/staging.env`
#      and restart `truckly-staging-api`.
#   3. Symlink `/etc/nginx/sites-enabled/truckly-staging`, validate with `nginx -t`, then `systemctl reload nginx`.
#   4. Configure `/etc/letsencrypt/renewal-hooks/deploy/truckly-nginx-reload.sh` (`nginx -t && systemctl reload nginx`).

server {
    listen 80;
    listen [::]:80;
    server_name __STAGING_FQDN__;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __STAGING_FQDN__;

    ssl_certificate /etc/letsencrypt/live/__STAGING_FQDN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__STAGING_FQDN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TrucklyStagingTLS:2m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    client_max_body_size 64k;

    # Block internal supervisor worker, operator staging mailbox & diagnostic endpoints from public internet
    location = /api/pager/worker {
        return 403;
    }

    location = /api/auth/staging-mailbox {
        return 404;
    }

    location = /api/_staging_gate_probe {
        return 404;
    }

    location ^~ /__debug {
        return 404;
    }

    # Explicit non-cached Service Worker delivery (repeats server-level security headers per Nginx add_header rules)
    location = /sw.js {
        proxy_pass http://127.0.0.1:4100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Service-Worker-Allowed "/" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    location / {
        proxy_pass http://127.0.0.1:4100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite forwarding headers from direct TCP peer ($remote_addr) so clients cannot spoof XFF
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
