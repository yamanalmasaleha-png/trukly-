# Host-specific Nginx virtual host for Truckly Isolated Staging.
# Never uses `server_name _;` or `default_server` so existing `/etc/nginx/sites-enabled/lifestyle-api`
# default HTTP routing on port 80 remains completely undisturbed.

server {
    listen 80;
    listen [::]:80;
    server_name __STAGING_FQDN__;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __STAGING_FQDN__;

    ssl_certificate /etc/letsencrypt/live/__STAGING_FQDN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__STAGING_FQDN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TrucklyStagingTLS:2m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # Prevent search engines from indexing isolated staging
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    client_max_body_size 64k;

    # Block internal supervisor worker & debug endpoints from public internet
    location = /api/pager/worker {
        return 403;
    }

    location ^~ /__debug {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:4100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite forwarding headers from direct TCP peer ($remote_addr) so clients cannot spoof XFF
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
