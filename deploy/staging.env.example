# Copy to `/etc/truckly-staging/staging.env` (chown root:truckly-stg, chmod 0640).
# NEVER commit real secrets to Git or store inside `/srv/truckly-staging/releases/*`.
#
# Compatibility & Precedence (`lib/env-compat.js`):
#   - `BITESHARK_*` is the primary configuration namespace for BiteShark deployments.
#   - Legacy `TRUCKLY_*` variables already present on existing staging hosts remain supported
#     seamlessly when `BITESHARK_*` is unset or set to the identical value.
#   - Supplying DIFFERENT non-empty values for both `BITESHARK_<KEY>` and `TRUCKLY_<KEY>` on
#     any security-critical setting fails closed on startup (`EnvAliasConflictError`).

NODE_ENV=production
BITESHARK_ENV=staging
BITESHARK_RELEASE_SHA=__RELEASE_SHA__

HOST=127.0.0.1
PORT=4100
# Keep `none` while running loopback-only (before Nginx is active) so local/tunneled callers
# cannot spoof `X-Real-IP` / `X-Forwarded-For`. Switch to `loopback` ONLY when enabling the
# Nginx vhost (`deploy/nginx/staging.biteshark.live.conf.template`), which overwrites both headers from `$remote_addr`.
BITESHARK_TRUST_PROXY=none
# Set once staging HTTPS hostname is active to enforce exact canonical Origin/Host matching:
# BITESHARK_PUBLIC_ORIGIN=https://staging.biteshark.live
BITESHARK_DB_POOL_MAX=6
BITESHARK_WORKER_DB_POOL_MAX=3

# Runtime database connection MUST use the restricted NOBYPASSRLS role (`truckly_stg_app`)
DATABASE_URL=postgres://truckly_stg_app:__CHANGE_ME_DB_APP_PASSWORD__@127.0.0.1:5432/truckly_staging

# Server-only HMAC secret (>= 32 random bytes hex/base64url)
BITESHARK_AUTH_SECRET=__CHANGE_ME_MIN_32_CHARS__

# Authentication delivery mode: `staging_mailbox` (restricted test accounts) or `resend_https` / `webhook_https`
BITESHARK_AUTH_DELIVERY_MODE=staging_mailbox
BITESHARK_STAGING_MAILBOX_SECRET=__CHANGE_ME_MIN_24_CHARS__
BITESHARK_STAGING_ALLOWED_EMAIL_DOMAINS=staging.truckly.invalid

# Optional HTTPS email provider settings (when BITESHARK_AUTH_DELIVERY_MODE=resend_https)
# BITESHARK_AUTH_EMAIL_API_KEY=
# BITESHARK_AUTH_EMAIL_FROM=BiteShark Staging <login@biteshark.live>

# Background pager notification worker & Web Push configuration
BITESHARK_WORKER_URL=http://127.0.0.1:4100/api/pager/worker
BITESHARK_NOTIFICATION_WORKER_SECRET=__CHANGE_ME_MIN_24_CHARS__
BITESHARK_PUSH_PROVIDER_MODE=disabled
# Enable `webpush` with staging-only VAPID keys only for designated physical-device verification:
# BITESHARK_VAPID_PUBLIC_KEY=
# BITESHARK_VAPID_PRIVATE_KEY=
# BITESHARK_VAPID_SUBJECT=mailto:ops-staging@biteshark.live

# Optional operational write pause (`bookings`, `pagers`, `community`, `owner`, `notifications`, or `all`)
BITESHARK_PAUSE_WRITES=

# Ephemeral gate verification probe (set to 1 ONLY during G1-G11 gate run, then unset/0)
BITESHARK_ENABLE_STAGING_PROBE=0
# BITESHARK_STAGING_PROBE_TOKEN=
