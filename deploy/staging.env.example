# Copy to `/etc/truckly-staging/staging.env` (chown root:truckly-stg, chmod 0640).
# NEVER commit real secrets to Git or store inside `/srv/truckly-staging/releases/*`.

NODE_ENV=production
TRUCKLY_ENV=staging
TRUCKLY_RELEASE_SHA=__RELEASE_SHA__

HOST=127.0.0.1
PORT=4100
TRUCKLY_TRUST_PROXY=loopback
# Set once staging HTTPS hostname is assigned to enforce exact canonical Origin/Host matching:
# TRUCKLY_PUBLIC_ORIGIN=https://__STAGING_FQDN__
TRUCKLY_DB_POOL_MAX=6
TRUCKLY_WORKER_DB_POOL_MAX=3

# Runtime database connection MUST use the restricted NOBYPASSRLS role (`truckly_stg_app`)
DATABASE_URL=postgres://truckly_stg_app:__CHANGE_ME_DB_APP_PASSWORD__@127.0.0.1:5432/truckly_staging

# Server-only HMAC secret (>= 32 random bytes hex/base64url)
TRUCKLY_AUTH_SECRET=__CHANGE_ME_MIN_32_CHARS__

# Authentication delivery mode: `staging_mailbox` (restricted test accounts) or `resend_https` / `webhook_https`
TRUCKLY_AUTH_DELIVERY_MODE=staging_mailbox
TRUCKLY_STAGING_MAILBOX_SECRET=__CHANGE_ME_MIN_24_CHARS__
TRUCKLY_STAGING_ALLOWED_EMAIL_DOMAINS=staging.truckly.invalid

# Optional HTTPS email provider settings (when TRUCKLY_AUTH_DELIVERY_MODE=resend_https)
# TRUCKLY_AUTH_EMAIL_API_KEY=
# TRUCKLY_AUTH_EMAIL_FROM=Truckly Staging <login@example.com>

# Background pager notification worker & Web Push configuration
TRUCKLY_WORKER_URL=http://127.0.0.1:4100/api/pager/worker
TRUCKLY_NOTIFICATION_WORKER_SECRET=__CHANGE_ME_MIN_24_CHARS__
TRUCKLY_PUSH_PROVIDER_MODE=disabled
# Enable `webpush` with staging-only VAPID keys only for designated physical-device verification:
# TRUCKLY_VAPID_PUBLIC_KEY=
# TRUCKLY_VAPID_PRIVATE_KEY=
# TRUCKLY_VAPID_SUBJECT=mailto:ops-staging@example.com

# Optional operational write pause (`bookings`, `pagers`, `community`, `owner`, `notifications`, or `all`)
TRUCKLY_PAUSE_WRITES=

# Ephemeral gate verification probe (set to 1 ONLY during G1-G9 gate run, then unset/0)
TRUCKLY_ENABLE_STAGING_PROBE=0
# TRUCKLY_STAGING_PROBE_TOKEN=
