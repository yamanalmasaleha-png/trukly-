{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yamanalmasaleha-png/trukly-/docs/engineering/schemas/drift-baseline.schema.json",
  "title": "BiteShark Audited Drift Baseline Debt Schema (v2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "description",
    "high_confidence_blocking_categories",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": "biteshark.drift-baseline.v2" },
    "description": { "type": "string", "minLength": 10 },
    "high_confidence_blocking_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "category", "accepted_reason", "reference"],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^DRIFT:[A-Z0-9_]+:.+$" },
          "category": { "type": "string", "minLength": 1 },
          "accepted_reason": { "type": "string", "minLength": 12 },
          "reference": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
