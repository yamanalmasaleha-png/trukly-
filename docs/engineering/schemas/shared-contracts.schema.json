{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yamanalmasaleha-png/trukly-/docs/engineering/schemas/shared-contracts.schema.json",
  "title": "BiteShark High-Value Shared Contracts Schema (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "description", "contracts"],
  "properties": {
    "schema_version": { "const": "biteshark.shared-contracts.v1" },
    "description": { "type": "string", "minLength": 10 },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_id",
          "title",
          "domain",
          "shape_evidence_basis",
          "purpose",
          "implementation_symbols",
          "inputs_and_validation",
          "outputs",
          "errors",
          "side_effects",
          "permissions_and_ownership",
          "idempotency_and_concurrency",
          "known_consumers",
          "compatibility_expectations",
          "known_limitations",
          "test_mappings"
        ],
        "properties": {
          "contract_id": { "type": "string", "pattern": "^CTR-[A-Z0-9-]+$" },
          "title": { "type": "string", "minLength": 5 },
          "domain": { "type": "string", "minLength": 2 },
          "shape_evidence_basis": {
            "enum": [
              "validated_runtime_checks_and_sql_schema",
              "declared_exports_and_runtime_guards",
              "inferred_from_handler_and_client_usage"
            ]
          },
          "purpose": { "type": "string", "minLength": 10 },
          "implementation_symbols": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "http_routes": { "type": "array", "items": { "type": "string", "pattern": "^/api/" } },
          "db_tables": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "feature_controls": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "inputs_and_validation": { "type": "string", "minLength": 5 },
          "outputs": { "type": "string", "minLength": 5 },
          "errors": { "type": "string", "minLength": 5 },
          "side_effects": { "type": "string", "minLength": 5 },
          "permissions_and_ownership": { "type": "string", "minLength": 5 },
          "idempotency_and_concurrency": { "type": "string", "minLength": 5 },
          "known_consumers": { "type": "array", "items": { "type": "string" } },
          "compatibility_expectations": { "type": "string", "minLength": 5 },
          "known_limitations": { "type": "string", "minLength": 5 },
          "test_mappings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "protected_assertions"],
              "properties": {
                "file": { "type": "string", "minLength": 5 },
                "protected_assertions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "authentication",
                      "ownership_rls",
                      "role_restrictions",
                      "input_validation",
                      "response_shape",
                      "feature_disabled",
                      "idempotency",
                      "concurrency_locking",
                      "rollback_and_recovery"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
