{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biteshark.live/schemas/style-guide-decisions.schema.json",
  "title": "BiteShark Unfilled Design Style Guide & Completion Tracker Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "guide_title",
    "repository",
    "source_branch_context",
    "mandatory_invariants",
    "topics",
    "component_dimensions_catalog",
    "components",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "biteshark.style-guide-decisions.v1"
    },
    "guide_title": {
      "type": "string",
      "minLength": 5
    },
    "repository": {
      "type": "string",
      "minLength": 10
    },
    "source_branch_context": {
      "type": "string",
      "minLength": 3
    },
    "mandatory_invariants": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/MandatoryInvariant"
      }
    },
    "topics": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/TopicDefinition"
      }
    },
    "component_dimensions_catalog": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "$ref": "#/$defs/DimensionDefinition"
      }
    },
    "components": {
      "type": "array",
      "minItems": 20,
      "items": {
        "$ref": "#/$defs/InventoriedComponent"
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 100,
      "items": {
        "$ref": "#/$defs/DesignDecision"
      }
    }
  },
  "$defs": {
    "MandatoryInvariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariant_id",
        "category",
        "title",
        "summary",
        "authoritative_docs"
      ],
      "properties": {
        "invariant_id": {
          "type": "string",
          "pattern": "^INV-[A-Z0-9-]+$"
        },
        "category": {
          "type": "string",
          "enum": [
            "security_and_permissions",
            "privacy_and_age_policy",
            "accessibility_floor",
            "truthful_content_and_legal"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "summary": {
          "type": "string",
          "minLength": 15
        },
        "authoritative_docs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "TopicDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "file",
        "title",
        "order",
        "scope_summary",
        "mandatory_invariant_ids"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "file": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.md$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "scope_summary": {
          "type": "string",
          "minLength": 15
        },
        "mandatory_invariant_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^INV-[A-Z0-9-]+$"
          }
        }
      }
    },
    "DimensionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "description"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "label": {
          "type": "string",
          "minLength": 3
        },
        "description": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "InventoriedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "implementation_name",
        "topic",
        "applicability",
        "applicability_note",
        "selectors",
        "dom_ids",
        "definition_files",
        "definition_symbols",
        "screens",
        "user_roles",
        "existing_variants",
        "existing_states",
        "related_feature_keys",
        "source_and_handbook_links",
        "evidence_level",
        "unresolved_references"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^CMP-[A-Z0-9-]+$"
        },
        "implementation_name": {
          "type": "string",
          "minLength": 3
        },
        "topic": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "applicability": {
          "type": "string",
          "enum": [
            "applicable",
            "not_applicable",
            "unconfirmed"
          ]
        },
        "applicability_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dom_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "definition_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "definition_symbols": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "screens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "user_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "Anonymous Visitor",
              "Customer",
              "Vendor Staff",
              "Vendor Owner",
              "Admin: Mod",
              "Admin: Top"
            ]
          }
        },
        "existing_variants": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "existing_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "related_feature_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "source_and_handbook_links": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "confirmed_static",
            "inferred_candidate",
            "unconfirmed_future_or_branch"
          ]
        },
        "unresolved_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "ExpectedAnswerSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "constraints"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "boolean",
            "number",
            "integer",
            "enum_choice",
            "string_list",
            "token_map",
            "structured_spec"
          ]
        },
        "allowed_choices": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "allows_decision_ref": {
          "type": "boolean"
        },
        "constraints": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "ApprovalMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "DesignDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "topic",
        "component_id",
        "section",
        "dimension",
        "title",
        "question",
        "expected_answer",
        "applicability",
        "applicability_note",
        "value",
        "status",
        "not_applicable_reason",
        "approval",
        "related_decisions",
        "mandatory_invariant_ids"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^DEC-[A-Z0-9-]+$"
        },
        "topic": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "component_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": "string",
          "minLength": 3
        },
        "dimension": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 4
        },
        "question": {
          "type": "string",
          "minLength": 15
        },
        "expected_answer": {
          "$ref": "#/$defs/ExpectedAnswerSpec"
        },
        "applicability": {
          "type": "string",
          "enum": [
            "applicable",
            "not_applicable",
            "unconfirmed"
          ]
        },
        "applicability_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "unanswered",
            "draft",
            "approved",
            "not_applicable"
          ]
        },
        "not_applicable_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "approval": {
          "$ref": "#/$defs/ApprovalMetadata"
        },
        "related_decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DEC-[A-Z0-9-]+$"
          }
        },
        "mandatory_invariant_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^INV-[A-Z0-9-]+$"
          }
        }
      }
    }
  }
}
