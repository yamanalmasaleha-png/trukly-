{
  "name": "biteshark",
  "version": "1.0.0",
  "private": true,
  "description": "BiteShark Sonoma County food discovery, event inquiries, pickup pagers, and standalone Node/PostgreSQL runtime",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "worker": "node scripts/run-pager-worker.cjs",
    "migrate": "node scripts/run-migrations.cjs",
    "bootstrap:top-admin": "node scripts/bootstrap-top-admin.cjs",
    "build:release": "node scripts/build-linux-release-tarball.cjs",
    "dev:simulator": "node scripts/dev-server.cjs",
    "test:smoke": "node tests/pager-demo.test.cjs",
    "test:parity": "node tests/listing-verification.cjs",
    "test:deploy": "node tests/install-staging-release.test.cjs",
    "test:standalone": "node tests/standalone-runtime-auth.integration.cjs",
    "test:admin": "node tests/admin-governance.integration.cjs",
    "test:legal": "node tests/legal-readiness.integration.cjs",
    "test:hardening": "node tests/backend-hardening.integration.cjs",
    "test:discovery": "node tests/p1-unified-discovery.integration.cjs",
    "test:notifications": "node tests/pager-notifications.integration.cjs",
    "test:gates:preflight": "node tests/vps-staging-gates.cjs --preflight-local",
    "test:e2e:discovery": "node tests/discovery-browser.e2e.cjs",
    "test:e2e:notifications": "node tests/pager-notifications-browser.e2e.cjs",
    "test:e2e:admin": "node tests/admin-portal-browser.e2e.cjs",
    "test:e2e:legal": "node tests/legal-readiness-browser.e2e.cjs",
    "test:platform": "node tests/vps-platform-contract.test.cjs",
    "test:email": "node tests/auth-email-delivery.integration.cjs",
    "registry:scan": "node tools/code-registry/cli.mjs scan",
    "registry:docs": "node tools/code-registry/cli.mjs generate-docs",
    "registry:validate": "node tools/code-registry/cli.mjs validate",
    "registry:accept-drift": "node tools/code-registry/cli.mjs accept-drift",
    "registry:prune-drift": "node tools/code-registry/cli.mjs prune-drift",
    "registry:compare": "node tools/code-registry/cli.mjs compare",
    "registry:impact": "node tools/code-registry/cli.mjs impact",
    "registry:locate": "node tools/code-registry/cli.mjs locate",
    "test:registry": "node tests/code-registry.test.cjs"
  },
  "dependencies": {
    "@biteshark/runtime-adapter": "file:./packages/runtime-adapter",
    "cookie": "1.1.1",
    "otplib": "13.6.0",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  }
}
